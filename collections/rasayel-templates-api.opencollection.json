            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Template"
        },
        {
          "info": {
            "name": "Delete Template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.rasayel.io/v1/templates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Template"
