{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rasayel REST Channels Tags API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rasayel.io/v1/tags"
          },
          "docs": "Fetch Tags"
        }
      ]
    }
  ],
  "bundled": true
}