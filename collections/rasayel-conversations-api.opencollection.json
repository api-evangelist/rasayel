{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rasayel REST Channels Conversations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Conversations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rasayel.io/v1/conversations"
          },
          "docs": "Fetch Conversations"
        },
        {
          "info": {
            "name": "Update Conversation",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.rasayel.io/v1/conversations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Conversation"
        }
      ]
    }
  ],
  "bundled": true
}